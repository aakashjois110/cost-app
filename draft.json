// Drafting helpers: search over the loaded price files, the prompt Claude receives, and clean-up of its reply.
'use strict';
function cleanDesc(d) { return d.replace(/^(Note:[^]*?(\(R\)|\.)\s+)+/, '').replace(/\s+/g, ' '); }
function searchSource(source, text, n) {
  const q = String(text || '').toLowerCase().trim(); if (!q) return [];
  const words = q.split(/\s+/).filter(w => w.length > 1), need = Math.max(1, Math.ceil(words.length * 0.6));
  const pool = source === 'mbs' ? mbs : source === 'pbs' ? pbsList : hosp;
  const scored = [];
  for (const x of pool) {
    const code = (x.item || x.code || '').toLowerCase();
    let sc = code === q ? 100 : 0;
    for (const w of words) { const at = x.lc.indexOf(w); if (at >= 0) { sc++; if (at < 90) sc += 0.4; } }
    if (sc >= need) scored.push([sc, x]);
  }
  scored.sort((a, b) => b[0] - a[0] || (a[1].lc.length - b[1].lc.length));
  return scored.slice(0, n).map(([, x]) => source === 'mbs'
    ? { code: x.item, description: cleanDesc(x.desc).slice(0, 190), schedule_fee: x.fee, benefit_out_of_hospital: x.b100 ?? x.b85, benefit_in_hospital: x.b75 }
    : source === 'pbs' ? { code: x.code, program: x.prog, medicine: x.drug + ', ' + x.form, max_quantity: x.maxqty, repeats: x.repeats, dpmq: x.dpmq }
    : { code: x.code, class: x.stream, description: x.desc, price_inlier: x.price, price_same_day: x.sdPrice, average_stay_days: x.alos });
}
const SEARCH_TOOL = {
  name: 'search_prices',
  description: 'Search the loaded Australian price files. Pass up to 12 queries at once. source "mbs" searches MBS item descriptors (Nov 2026), "pbs" searches PBS medicines by generic name and form (Nov 2026), "hospital" searches AR-DRG V12.0 admitted classes, Tier 2 outpatient clinic classes and ED classes with 2026-27 NEP prices. Returns up to 6 matches per query with code and price. Use short queries of 1 to 4 words, such as "echocardiography", "apixaban", "atrial fibrillation", "cardioversion".',
  inputSchema: { type: 'object', properties: { queries: { type: 'array', maxItems: 12, items: { type: 'object', properties: { source: { type: 'string', enum: ['mbs', 'pbs', 'hospital'] }, text: { type: 'string' } }, required: ['source', 'text'] } } }, required: ['queries'] },
  execute(input) {
    const qs = Array.isArray(input.queries) ? input.queries.slice(0, 12) : [];
    if (!qs.length) throw new Error('Pass queries as a list of {source, text}');
    setStatus('Claude is searching the price files: ' + qs.map(q => String(q.text)).join(', '));
    return qs.map(q => ({ source: q.source, query: q.text, results: searchSource(q.source === 'hospital' ? 'hosp' : String(q.source), q.text, 6) }));
  }
};

function draftPrompt(dx, ctx, hor) {
  return `You are drafting a care pathway costing model for the Australian health system. A web page will cost your pathway using the official price files it has loaded, so every service must be a real code from those files.

Diagnosis or presentation: ${dx}
Patient group and setting: ${ctx || 'not specified; assume the typical adult patient managed in the Australian system'}
Time horizon: ${hor}

Method:
1. Work out the usual Australian care pathway for this cohort over the time horizon, from first presentation or diagnosis, following current Australian guidelines where you know them (for example Heart Foundation, RACGP, eTG, Australian Commission on Safety and Quality in Health Care clinical care standards), and international guidelines where no Australian one exists.
2. Use the search_prices tool to find the code for every service: GP and specialist attendances, tests and imaging (mbs), medicines (pbs), public hospital admissions, ED attendances and outpatient clinics (hospital). Batch your searches, up to 12 queries per call, and use at most 3 calls. Use ONLY codes the tool returned to you.
3. Reply with the pathway as JSON.

Modelling rules:
- 8 to 20 steps. Each step is one service type.
- "prob" is the probability that a patient who reached the parent step receives this step, between 0 and 1. Root steps have "parent": null and their prob is the share of the whole cohort.
- "qty" is how many times a patient who receives the step receives it within the horizon. For a PBS medicine, qty is the number of dispensings (original plus repeats) in the horizon, worked out from the max_quantity returned by the tool and the usual daily dose.
- Cost an admission as one hospital step (public patient, NEP price). Do not also add in-hospital MBS items for that admission. Use "basis": "same_day" only where the tool returned a same-day price and the admission is usually same day.
- MBS steps: "setting": "out" for out-of-hospital services, "in" only for private in-hospital services.
- "gap" is the typical out-of-pocket amount per service above the MBS schedule fee: 0 for bulk-billed GP visits, pathology and most imaging; a realistic figure for private specialist consultations and procedures; 0 for PBS and hospital steps.
- Give "lo" and "hi" for every prob, qty and gap to show real uncertainty.
- "ev" is "sourced" only where "ref" names a specific guideline or publication that supports that figure; otherwise "estimate". Keep each ref under 120 characters.
- "note" says in under 20 words why the step is there or who receives it.

Reply with only this JSON object:
{"name": "short title", "population": "...", "horizon": "...", "summary": "2 to 3 sentences describing the pathway", "caveats": ["up to 3 short limitations"],
 "steps": [{"id": "short-slug", "label": "...", "note": "...", "parent": null,
   "price": {"type": "mbs", "code": "23", "setting": "out"} or {"type": "pbs", "code": "8655M"} or {"type": "hospital", "code": "F42B", "basis": "inlier"},
   "prob": {"v": 0.8, "lo": 0.6, "hi": 0.95, "ev": "estimate", "ref": ""},
   "qty": {"v": 1, "lo": 1, "hi": 2, "ev": "estimate", "ref": ""},
   "gap": {"v": 0, "lo": 0, "hi": 0, "ev": "estimate", "ref": ""}}]}`;
}

// Turn Claude's reply into a pathway the engine accepts. Drafted figures are always marked as estimates.
function normaliseDraft(raw, dx) {
  if (!raw || !Array.isArray(raw.steps) || !raw.steps.length) throw new Error('The reply had no steps.');
  const ids = new Set();
  const fix = (f, dv) => {
    const o = f && typeof f === 'object' ? f : { v: f };
    const v = o.v !== null && o.v !== '' && isFinite(+o.v) ? +o.v : dv;
    const ref = String(o.ref || '').trim();
    return { v, lo: isFinite(+o.lo) && o.lo !== null && o.lo !== '' ? +o.lo : v, hi: isFinite(+o.hi) && o.hi !== null && o.hi !== '' ? +o.hi : v, ev: 'estimate',
      ref: ref ? (o.ev === 'sourced' ? 'Claude cited (unchecked): ' : '') + ref : '' };
  };
  const steps = raw.steps.map((st, i) => {
    let id = String(st.id || 'step-' + (i + 1)).toLowerCase().replace(/[^a-z0-9-]+/g, '-').slice(0, 24) || 'step-' + (i + 1);
    while (ids.has(id)) id += '-' + i; ids.add(id);
    const p = st.price || {};
    let price;
    if (p.type === 'pbs') price = { type: 'pbs', code: String(p.code || '').trim() };
    else if (p.type === 'hospital' || p.type === 'hosp') price = { type: 'hosp', code: String(p.code || '').trim(), basis: p.basis === 'same_day' ? 'same_day' : 'inlier', paed: !!p.paed };
    else if (p.type === 'manual') price = { type: 'manual', amount: +p.amount || 0, ref: String(p.ref || '') };
    else price = { type: 'mbs', code: String(p.code || '').trim(), setting: p.setting === 'in' ? 'in' : 'out' };
    if (price.type === 'pbs' && I.pbs.has(price.code)) price.prog = I.pbs.get(price.code).prog;
    return { id, _rawParent: st.parent, label: String(st.label || id), note: String(st.note || ''), price,
      prob: fix(st.prob, 1), qty: fix(st.qty, 1), gap: fix(st.gap, 0) };
  });
  const map = new Map(raw.steps.map((st, i) => [String(st.id), steps[i].id]));
  for (const st of steps) { st.parent = st._rawParent != null && map.has(String(st._rawParent)) ? map.get(String(st._rawParent)) : null; delete st._rawParent; st.prob.v = Math.min(1, Math.max(0, st.prob.v)); }
  return { name: String(raw.name || dx), population: String(raw.population || ''), horizon: String(raw.horizon || ''), summary: String(raw.summary || ''),
    caveats: Array.isArray(raw.caveats) ? raw.caveats.slice(0, 4).map(String) : [], notes: '', copay: 'general',
    draft: { by: 'Claude', query: dx, date: new Date().toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric' }) }, steps };
}

const ERR = { not_granted: 'Claude isn’t allowed to run from this page, so drafting is off. You can still build pathways by hand.', sampling_disabled: 'Claude isn’t available for this account here.',
  rate_limited: 'Too many requests, or your Claude usage limit has been reached. Try again later.', session_expired: 'Sign in to Claude again, then retry.',
  refused: 'Claude declined this request. Try rewording the diagnosis.', invalid_json: 'Claude’s reply couldn’t be read as a pathway. Try again.',
  tools_unavailable: 'This view can’t give Claude the price search, so drafting is off here. Open the page in the Claude app or on claude.ai.', prompt_too_large: 'The search results grew too large. Try a narrower diagnosis.' };
